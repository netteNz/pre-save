# Copy to .env.local (gitignored by the *.local rule) and fill in.
# Only public values belong here: they are bundled into the browser build.
# Service-role, email-provider and Stripe keys go in Edge Function secrets
# (see supabase/functions/.env.example), never here.

# Local Supabase prints these with `supabase status`; a hosted project shows
# them under Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Which campaign this build shows (phase 1 has no router yet).
VITE_ARTIST_SLUG=chris-wave
VITE_CAMPAIGN_SLUG=low-tide
