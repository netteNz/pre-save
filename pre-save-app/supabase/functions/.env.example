# Copy to supabase/functions/.env (gitignored) for local `supabase functions serve`.
# In a hosted project set these with `supabase secrets set`. SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are provided by the runtime; never put them in the frontend.

# Where confirm-email links point (the campaign page).
SITE_URL=http://localhost:5173

# Browser-reachable API origin, used to rewrite signed reward URLs locally.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Comma-separated list, or * for any origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local only: return the confirm link in the claim-email response when no
# email provider is configured. Never set in production.
DEV_EXPOSE_CONFIRM_LINK=true

# Email provider (not chosen yet). Leave empty locally: links are logged instead.
RESEND_API_KEY=
MAIL_FROM=

# Optional tuning
# RATE_LIMIT_PER_IP=10
# RATE_LIMIT_PER_CAMPAIGN=300
# REWARD_LISTEN_TTL=900
# REWARD_DOWNLOAD_TTL=60
